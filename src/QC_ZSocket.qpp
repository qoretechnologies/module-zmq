enum qzmq_option_type {
    QZOT_INT = 0,
    QZOT_BIN = 1,
    QZOT_INT64 = 2,
    QZOT_STR = 3,
    QZOT_BOOL = 4,
    QZOT_CURVEKEY = 5,
};

